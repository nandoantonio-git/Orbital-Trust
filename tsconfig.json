{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "target": "esnext",
    "allowJs": true
  },
  "include": ["mobile/**/*.ts", "mobile/**/*.tsx"],
  "exclude": ["mobile/node_modules"]
}
