# =============================================================================
# Orbital Trust — .gitignore
# =============================================================================

# -------------------------------------
# Infraestrutura e Scripts de Suporte
# -------------------------------------
scripts/audit/
scripts/ralph.sh
scripts/implement.sh
scripts/record.sh
scripts/prd.json
scripts/.current-provider
scripts/.last-story
scripts/.story-attempts
scripts/.prompt.md
scripts/.last-message.md
scripts/.model-check.log
scripts/run.log
scripts/events.log
scripts/.iter.log

# -------------------------------------
# Diretórios de Experimento/Conhecimento (não pertencem ao produto final)
# -------------------------------------
skills/
loops/
memory/
AGENTS.md
AGENTS.md.backup
AGENTS.md.candidate
PRD.pdf

# -------------------------------------
# Python
# -------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.coverage
htmlcov/

# Modelos ML serializados (binários grandes — commitar apenas versões de release)
models/*.pkl
models/*.joblib
models/*.pkl.gz
models/*.h5

# -------------------------------------
# Node / Expo
# -------------------------------------
node_modules/
.expo/
mobile/.expo/
mobile/node_modules/
dist/
build/

# -------------------------------------
# Dados gerados / sensíveis
# -------------------------------------
data/raw/
data/generated_mock_tile_evidence.json

# Mock data gerado para o app — NÃO ignorar, deve ser versionado
# mobile/src/services/generatedMockData.ts <- intencional: versionado

# -------------------------------------
# Variáveis de ambiente
# -------------------------------------
.env
.env.*
.env.local
!mobile/.env.example

# -------------------------------------
# macOS / IDEs
# -------------------------------------
.DS_Store
.idea/
.vscode/settings.json
*.swp
*.swo

# -------------------------------------
# Videos e outros arquivos grandes que não devem ser versionados
# -------------------------------------
*.mp4
*.mov
*.avi
